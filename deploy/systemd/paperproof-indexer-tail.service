[Unit]
Description=PaperProof canonical event tail indexer
Documentation=https://github.com/PaperProofLabs/paperproof-sdk-rs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperproof
Group=paperproof
EnvironmentFile=/etc/paperproof/indexer.env
ExecStartPre=/usr/local/bin/paperproof-check-deployment-update
ExecStart=/usr/local/bin/paperproof-indexer-tail
Restart=always
RestartSec=10
TimeoutStartSec=60
StateDirectory=paperproof
WorkingDirectory=/var/lib/paperproof
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperproof
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
