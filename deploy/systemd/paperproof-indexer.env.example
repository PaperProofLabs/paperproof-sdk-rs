RUST_LOG=paperproof_sdk_rs=info
PAPERPROOF_RS_INDEXER_OUT=/var/lib/paperproof/indexer
PAPERPROOF_RS_TAIL=1
PAPERPROOF_RS_TAIL_INTERVAL_MS=10000
PAPERPROOF_RS_TAIL_LIMIT=50
PAPERPROOF_RS_BACKFILL_LIMIT=100
PAPERPROOF_RS_BACKFILL_PAGES=10

# Checkpoint ingestion options. Build with --features sui-native to enable.
# Leave PAPERPROOF_RS_CHECKPOINT_START unset for cursor resume.
PAPERPROOF_RS_CHECKPOINT=0
# PAPERPROOF_RS_CHECKPOINT_START=1000000
PAPERPROOF_RS_CHECKPOINT_COUNT=100
PAPERPROOF_RS_CHECKPOINT_BATCH=10
PAPERPROOF_RS_CHECKPOINT_WORKERS=4
# PAPERPROOF_RS_CHECKPOINTS_PER_SECOND=50

# Sink options:
# - jsonl: write accepted/rejected JSONL files under PAPERPROOF_RS_INDEXER_OUT.
# - sqlite: persist events and cursors to PAPERPROOF_RS_SQLITE_PATH; build with --features sqlite.
# - postgres: persist events and cursors to PAPERPROOF_RS_POSTGRES_URL; build with --features postgres.
PAPERPROOF_RS_SINK=jsonl
PAPERPROOF_RS_SQLITE_PATH=/var/lib/paperproof/indexer/paperproof-indexer.sqlite
# PAPERPROOF_RS_POSTGRES_URL=postgres://paperproof:paperproof@localhost/paperproof
